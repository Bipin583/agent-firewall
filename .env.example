# Agent Firewall configuration (copy to .env; never commit real values)

# --- Core engine (used by the hook; no network/DB required) ---
# Path to the policy file the engine loads. Relative paths resolve from the
# project root. If unset, the bundled policies/default.yaml is used.
AGENT_FIREWALL_POLICY_FILE=policies/default.yaml

# Append-only audit log location (JSONL). The hook writes here.
AGENT_FIREWALL_AUDIT_LOG=.agent_firewall/audit.jsonl

# Logical environment name applied to requests (development|staging|production).
AGENT_FIREWALL_ENV=development

# What the hook does when evaluation fails or input cannot be parsed:
#   ask  -> surface to the human (default; fail-safe, non-blocking of workflow)
#   deny -> block the operation (fail-closed; most secure, may be noisy)
#   allow-> defer to Claude Code native permissions (least secure; not recommended)
AGENT_FIREWALL_ON_ERROR=ask

# The project directory treated as the trusted boundary. Defaults to the hook's
# cwd. Reads/writes outside this boundary are treated as higher risk.
# AGENT_FIREWALL_PROJECT_ROOT=

# --- API / dashboard (optional; not needed for local enforcement) ---
AGENT_FIREWALL_DB_URL=sqlite+aiosqlite:///./data/agent_firewall.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/agent_firewall
AGENT_FIREWALL_API_TOKEN=change-me-local-dev-only
